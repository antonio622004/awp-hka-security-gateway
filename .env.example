# Copy to .env if desired. Paths/names below are placeholders, never secret values.
# Compose does not expand $HOME inside values read from .env: use absolute paths.
GW_LOCAL_DIR=/absolute/path/outside/repositories/hka-gateway
GW_KEYCLOAK_NETWORK=replace-with-existing-keycloak-network
GW_OIDC_CLIENT_SECRET_FILE=/absolute/path/outside/repositories/hka-gateway/oidc-client-secret
HKA_REGISTRY_SERVICE_TOKEN_FILE=/absolute/path/outside/repositories/hka-gateway/registry-service-token
GW_PUBLIC_URL=http://localhost:18080
GW_OIDC_ISSUER=http://localhost:8180/realms/hka
GW_OIDC_DISCOVERY_URL=http://keycloak:8080/realms/hka/.well-known/openid-configuration
GW_OIDC_CLIENT_ID=portal
GW_COOKIE_SECURE=false
