# Vorlage für server/.env (lokaler Gesamtstart). Nicht von Hand kopieren: "make server-init" schreibt
# server/.env daraus, falls sie fehlt, und füllt die leeren Werte unten aus.
# Hier stehen nur Werte, die gesetzt werden MÜSSEN. Alles andere hat einen lokalen Standard in den Compose-Dateien.
#
# Pfade sind absolut: Compose ersetzt $HOME in .env-Werten nicht, und relative Pfade gälten ab dem Ordner
# der jeweiligen Compose-Datei (z. B. gateway/), nicht ab server/.

# Rollen-Zuordnung (IdP-Claims -> Rollen): awp-hka-intranet-portal/dev/roles.yml
GW_ROLES_SOURCE=

# Secret des Keycloak-Clients "portal", übernommen aus keycloak/hka-realm.json -> server/.secrets/oidc-client-secret
GW_OIDC_CLIENT_SECRET_SOURCE=

# Signierschlüssel des Gateways (RSA 3072, PKCS#8) -> server/.secrets/signing-key.pem
GW_SIGNING_KEY_SOURCE=

# Token für Gateway -> Portal (Registry-API), zufällig -> server/.secrets/registry-service-token
HKA_REGISTRY_SERVICE_TOKEN_SOURCE=

# Fernet-Schlüssel des Adapters (verschlüsselt die bwSync-App-Passwörter) -> server/.secrets/bwsync-credentials.key
# Bei vorhandenen Adapter-Daten NIE einen neuen Schlüssel nehmen, sonst sind die gespeicherten Passwörter verloren.
BWSYNC_CREDENTIALS_KEY_SOURCE=

# Admin der Keycloak-Konsole (http://localhost:8180, Benutzer admin), zufällig erzeugt
KC_BOOTSTRAP_ADMIN_PASSWORD=
