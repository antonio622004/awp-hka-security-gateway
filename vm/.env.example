# Vorlage für vm/.env auf der Test-VM iwi-hean-05 (vm/compose.yml). Auf der VM kopieren und das Admin-Passwort
# von Keycloak setzen:  cp vm/.env.example vm/.env && chmod 600 vm/.env
# Hier stehen nur Werte, die sich von lokal unterscheiden; alles andere hat Standardwerte in den Compose-Dateien.
# Keine Secrets in dieser Datei: Secrets sind Dateien unter /srv/portal/gateway/secrets/ (docs/vm.md).

# ── Öffentliche Adresse: nginx mit HTTPS davor (extras/compose/vm/nginx-portal.conf im Portal) ─────────────────
GW_PUBLIC_URL=https://iwi-hean-05.hs-karlsruhe.de
# Issuer der Assertions = GW_PUBLIC_URL + "/" (Standard); muss zu gateway.issuer in dev/gateway.vm.yml passen
GW_COOKIE_SECURE=true

# ── Keycloak unter /auth (nginx: location /auth/ -> 127.0.0.1:8180) ────────────────────────────────────────────
# Der Browser sieht Keycloak unter https://…/auth; das Gateway holt Discovery, Token und Schlüssel intern.
# KC_PROXY_HEADERS=xforwarded ist fest in keycloak/compose.yml (nginx setzt X-Forwarded-*).
KC_HTTP_RELATIVE_PATH=/auth
KC_HOSTNAME=https://iwi-hean-05.hs-karlsruhe.de/auth
GW_OIDC_ISSUER=https://iwi-hean-05.hs-karlsruhe.de/auth/realms/hka
GW_OIDC_DISCOVERY_URL=http://keycloak:8080/auth/realms/hka/.well-known/openid-configuration
# Admin der Keycloak-Konsole (nur per SSH-Tunnel erreichbar). Auf der VM ersetzen, z. B.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
KC_BOOTSTRAP_ADMIN_PASSWORD=AUF-DER-VM-ERSETZEN

# ── Secrets und Rollen (Dateien auf der VM, nicht in Git; Ordner secrets/ 0700, Dateien 0444) ─────────────────
GW_OIDC_CLIENT_SECRET_SOURCE=/srv/portal/gateway/secrets/oidc-client-secret
GW_SIGNING_KEY_SOURCE=/srv/portal/gateway/secrets/signing-key.pem
HKA_REGISTRY_SERVICE_TOKEN_SOURCE=/srv/portal/gateway/secrets/registry-service-token
# Fernet-Schlüssel des Adapters: bei vorhandenen Adapter-Daten NIE einen neuen Schlüssel nehmen
BWSYNC_CREDENTIALS_KEY_SOURCE=/srv/portal/gateway/secrets/bwsync-credentials.key
# Kopie von awp-hka-intranet-portal/dev/roles.yml (IdP-Claims -> Rollen)
GW_ROLES_SOURCE=/srv/portal/gateway/roles.yml

# ── Portal ─────────────────────────────────────────────────────────────────────────────────────────────────
PORTAL_CONFIG=/opt/app/dev/gateway.vm.yml
# Gehärtetes Image (dhi.io); wirkt nur beim Bauen mit "make vm-images"
PORTAL_DOCKERFILE=Dockerfile
# Daten wie bisher: Manifeste (portal-deploy), Status (Prober), Besitzer/Stilllegungen/Grants (Verwaltungsseite)
PORTAL_MANIFESTS_SOURCE=/srv/portal/manifests
PORTAL_STATUS_SOURCE=/srv/portal/status
PORTAL_REGISTRY_SOURCE=/srv/portal/registry

# ── Image-Tags (make vm-images baut genau diese; auf der VM kommen sie per docker load) ──────────────────────────
# PORTAL_IMAGE_TAG muss zu PORTAL_IMAGE in /etc/portal/deploy.env passen (portal-deploy)
GW_IMAGE_TAG=0.2.0
KEYCLOAK_IMAGE_TAG=0.2.2
PORTAL_IMAGE_TAG=0.4.0-gateway
ADAPTER_IMAGE_TAG=0.1.0
# Redis: make vm-images taggt den Digest aus redis/compose.yml auf diesen Namen (beim Erhöhen des Digests mitändern)
REDIS_IMAGE=hka/redis:8.10.3-alpine
